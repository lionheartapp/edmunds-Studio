{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/ad-screenshot/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
