# AdGenAI Environment Variables
# Copy this to .env.local and fill in your keys

# AI Orchestration — Claude
ANTHROPIC_API_KEY=

# Image Generation + Voice — Google Cloud
GOOGLE_CLOUD_API_KEY=

# Design Generation — Figma
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# Social Publishing — Meta
META_APP_ID=
META_APP_SECRET=

# Social Publishing — TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage — Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Databricks — Real Edmunds Data
# Get your token from: https://edm-west.cloud.databricks.com → User Settings → Access Tokens
DATABRICKS_HOST=https://edm-west.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=97c55e8561894cb0

# Edmunds Internal APIs (optional — Databricks takes priority)
EDMUNDS_API_KEY=
EDMUNDS_API_BASE_URL=
EDMUNDS_INTERNAL_TOKEN=
